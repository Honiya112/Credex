<!-- Author: Honiya Maqsood | Description: Display financial history of all years -->

@model List<AnnualReport>

<div class="container mt-4">
    <h2 class="mb-4">Financial History (2002-2022)</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm rounded">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Year</th>
                    <th scope="col">Revenue (Billions)</th>
                    <th scope="col">Earning (Billions)</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td class="fw-bold">@report.Year</td>
                        <td>@report.Revenue.ToString("C2")</td>
                        <td>@report.Earnings.ToString("C2")</td>
                        <td class="text-center">
                            <a 
                                asp-controller="FinancialHistory" 
                                asp-action="Details" 
                                asp-route-id="@report.Id"
                                class="btn btn-primary btn-sm">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

 

