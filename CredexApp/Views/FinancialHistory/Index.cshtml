<!-- Author: Honiya Maqsood | Description: Display financial history of all years -->

@model List<AnnualReport>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Financial History (2002-2022)</h2>

        <div class="dropdown">
            <button class="dropbtn">Sort Options ▼</button>

            <div class="dropdown-content">
                <a asp-action="Index" asp-route-sortOption="@SortOptions.YearDescending">Year (Newest)</a>

                <a asp-action="Index" asp-route-sortOption="@SortOptions.YearAscending">Year (Oldest)</a>

                <a asp-action="Index" asp-route-sortOption="@SortOptions.RevenueDescending">Revenue (Highest)</a>

                <a asp-action="Index" asp-route-sortOption="@SortOptions.EarningsDescending">Earnings (Highest)</a>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm rounded">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Year</th>
                    <th scope="col">Revenue (Billions)</th>
                    <th scope="col">Earning (Billions)</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var report in Model) {
                    <tr>
                        <td class="fw-bold">@report.Year</td>
                        <td>@report.Revenue.ToString("C2")</td>
                        <td>@report.Earnings.ToString("C2")</td>
                        <td class="text-center">
                            <a 
                                asp-controller="FinancialHistory" 
                                asp-action="Details" 
                                asp-route-id="@report.Id"
                                class="btn btn-primary btn-sm">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

 

