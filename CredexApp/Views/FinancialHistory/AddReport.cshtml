<!-- Author: Honiya Maqsood | Description: Form to enter a new annual report -->
@model AnnualReport

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Add New Financial Report</h3>
                </div>

                <div class="card-body">
                    <form asp-controller="FinancialHistory" asp-action="AddReport" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label fw-bold">Year</label>
                            <input asp-for="Year" class="form-control" type="number" min="2023" max="2100" placeholder="e.g. 2023" required />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Revenue" class="form-label">Revenue (Billions)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Revenue" class="form-control" type="number" step="0.01" required />
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Earnings" class="form-label">Earnings (Billions)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Earnings" class="form-control" type="number" step="0.01" required />
                                </div>
                            </div>
                        </div>

                        <h5 class="mt-3 text-secondary border-bottom pb-2">Balance Sheet Details</h5>

                        <div class="row mt-3">
                            <div class="col-md-4 mb-3">
                                <label asp-for="TotalAssets" class="form-label">Total Assets</label>
                                <input asp-for="TotalAssets" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TotalDebt" class="form-label">Total Debt</label>
                                <input asp-for="TotalDebt" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TotalLiabilities" class="form-label">Total Liabilities</label>
                                <input asp-for="TotalLiabilities" class="form-control" type="number" step="0.01" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="FinancialHistory" asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success px-4">Save Report</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>