@model Transactions

@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <h3>Add New Transaction</h3>
    
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    
    <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        
        <input asp-for="TransactionId" type="hidden"></input>
        
        <div class="form-floating mb-3">
            <input asp-for="Spending" type="number" class="form-control rounded-4" placeholder="$$$$"></input>
            <label asp-for="Spending">Spending in $B</label>
            <span asp-validation-for="Spending" class="text-danger small"></span>
        </div>
        
        <div class="form-floating mb-3">
            <input asp-for="Earnings" type="number"
                   class="form-control rounded-4" placeholder="0.00" />
            <label asp-for="Earnings">Earnings ($)</label>
            <span asp-validation-for="Earnings" class="text-danger small"></span>
        </div>
        
        <div class="form-floating mb-3">
            <input asp-for="TransactionDate" type="date" 
                   class="form-control rounded-4" />
            <label asp-for="TransactionDate">Transaction Date</label>
            <span asp-validation-for="TransactionDate" class="text-danger small"></span>
        </div>
        
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"> Add Transaction! </button>
            <a asp-action="Index" class="btn btn-secondary"> Cancel </a>
        </div>
    </form>
</div>